; Throwaway spike project for task 01a0db5f stage 1. It has no editor plugins
; and no godot_ai autoload, so it cannot reach the editor agent's editor bridge.
config_version=5

[application]

config/name="burrow-play-spike-01a0db5f"
run/main_scene="res://main.tscn"

[autoload]

BurrowPlay="*res://addons/burrow_play/burrow_play.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="forward_plus"
